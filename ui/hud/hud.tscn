[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/hud/hud.gd" id="1_hud"]
[ext_resource type="PackedScene" path="res://ui/widgets/health_bar.tscn" id="2_bar"]
[ext_resource type="PackedScene" path="res://ui/widgets/notification_feed.tscn" id="3_feed"]
[ext_resource type="Theme" path="res://ui/theme/game_theme.tres" id="4_theme"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
offset_right = 440.0
offset_bottom = 110.0
mouse_filter = 2
theme = ExtResource("4_theme")
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16

[node name="Bars" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2

[node name="FortressBar" parent="Margin/Bars" instance=ExtResource("2_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "Fortress"
fill_color = Color(0.45, 0.55, 0.8, 1)

[node name="HeroBar" parent="Margin/Bars" instance=ExtResource("2_bar")]
unique_name_in_owner = true
layout_mode = 2
title = "Hero"
fill_color = Color(0.85, 0.72, 0.4, 1)

[node name="EnemyStatsLabel" type="Label" parent="Margin/Bars"]
unique_name_in_owner = true
layout_mode = 2
text = "Enemies alive: 0    Spawned: 0"

[node name="NotificationFeed" parent="." instance=ExtResource("3_feed")]
unique_name_in_owner = true
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -336.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 136.0
grow_horizontal = 0
theme = ExtResource("4_theme")
