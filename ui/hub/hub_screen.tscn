[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hub/hub_screen.gd" id="1_hub"]
[ext_resource type="PackedScene" path="res://ui/widgets/screen_frame.tscn" id="2_frame"]
[ext_resource type="PackedScene" path="res://ui/hub/chronicle_screen.tscn" id="3_chronicle"]
[ext_resource type="PackedScene" path="res://ui/hub/pressure_screen.tscn" id="4_pressure"]

[node name="HubScreen" type="CanvasLayer" groups=["ui_scaled"]]
layer = 20
script = ExtResource("1_hub")

[node name="Frame" parent="." instance=ExtResource("2_frame")]
title = "The War Room"

[node name="Content" type="VBoxContainer" parent="Frame/Margin/Panel/Box/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="Tabs" type="HBoxContainer" parent="Frame/Margin/Panel/Box/Content/Content"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="TabHeroes" type="Button" parent="Frame/Margin/Panel/Box/Content/Content/Tabs"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(170, 44)
toggle_mode = true
text = "Heroes"

[node name="TabUnlocks" type="Button" parent="Frame/Margin/Panel/Box/Content/Content/Tabs"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(170, 44)
toggle_mode = true
text = "Unlocks"

[node name="TabCouncil" type="Button" parent="Frame/Margin/Panel/Box/Content/Content/Tabs"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(170, 44)
toggle_mode = true
text = "Council"

[node name="TabRecords" type="Button" parent="Frame/Margin/Panel/Box/Content/Content/Tabs"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(170, 44)
toggle_mode = true
text = "Records"

[node name="Greeting" type="Label" parent="Frame/Margin/Panel/Box/Content/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Pages" type="VBoxContainer" parent="Frame/Margin/Panel/Box/Content/Content"]
layout_mode = 2
size_flags_vertical = 3

[node name="HeroPage" type="ScrollContainer" parent="Frame/Margin/Panel/Box/Content/Content/Pages"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Side" type="VBoxContainer" parent="Frame/Margin/Panel/Box/Content/Content/Pages/HeroPage"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="HeroTitle" type="Label" parent="Frame/Margin/Panel/Box/Content/Content/Pages/HeroPage/Side"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Your hero"

[node name="HeroPick" type="HBoxContainer" parent="Frame/Margin/Panel/Box/Content/Content/Pages/HeroPage/Side"]
