[node name="Main" type="Node"]
script = ExtResource("1_main")
run_data = ExtResource("2_run")
unlock_board = ExtResource("21_board")
story_book = ExtResource("99_story")

[node name="MapScreen" parent="." instance=ExtResource("6_map")]
unique_name_in_owner = true

[node name="MerchantScreen" parent="." instance=ExtResource("7_merchant")]
unique_name_in_owner = true

[node name="EventScreen" parent="." instance=ExtResource("8_event")]
unique_name_in_owner = true

[node name="ChapterScreen" parent="." instance=ExtResource("9_chapter")]
unique_name_in_owner = true

[node name="MapFlow" type="Node" parent="." node_paths=PackedStringArray("map_screen", "merchant_screen", "event_screen")]
unique_name_in_owner = true
script = ExtResource("23_flow")
map_screen = NodePath("../MapScreen")
merchant_screen = NodePath("../MerchantScreen")
event_screen = NodePath("../EventScreen")

[node name="HintPanel" parent="." instance=ExtResource("25_hint_panel")]
unique_name_in_owner = true

[node name="HintDirector" type="Node" parent="." node_paths=PackedStringArray("panel", "map_flow")]
unique_name_in_owner = true
script = ExtResource("24_hints")
panel = NodePath("../HintPanel")
map_flow = NodePath("../MapFlow")

