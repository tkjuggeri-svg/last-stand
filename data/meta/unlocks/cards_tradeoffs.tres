[gd_resource type="Resource" script_class="UnlockData" format=3]

[ext_resource type="Script" path="res://resources/unlock_data.gd" id="1_unlock"]
[ext_resource type="Script" path="res://resources/upgrade_data.gd" id="s2"]
[ext_resource type="Resource" path="res://data/upgrades/berserker.tres" id="r3"]
[ext_resource type="Resource" path="res://data/upgrades/overcharge.tres" id="r4"]

[resource]
script = ExtResource("1_unlock")
id = &"cards_tradeoffs"
display_name = "Cards: Trade-offs"
description = "Berserker's Oath and Overcharged Engines join the upgrade cards."
cost = 100
cards = Array[ExtResource("s2")]([ExtResource("r3"), ExtResource("r4")])
