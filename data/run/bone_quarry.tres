[resource]
script = ExtResource("1_chapter")
id = &"bone_quarry"
display_name = "The Bone Quarry"
tier = 1
level_scene = ExtResource("2_level")
map_look = ExtResource("look_bone_quarry")
blurb = "A quarry of cut stone and heaped bones. Two broad roads run down and merge before the fortress."
mechanic_text = "Rockfall: boulders crash onto the roads now and then (a warning first) and block them for 8 s: the dead queue up behind."
difficulty_note = "easy: Bone Hurlers silence your towers one at a time"
battles = Array[ExtResource("s_enc")]([ExtResource("b1"), ExtResource("b2"), ExtResource("b3"), ExtResource("b4"), ExtResource("b5"), ExtResource("b6")])
elites = Array[ExtResource("s_enc")]([ExtResource("e3"), ExtResource("e4"), ExtResource("e5"), ExtResource("e6")])
affixes = Array[ExtResource("s_affix")]([ExtResource("a_swift"), ExtResource("a_warded"), ExtResource("a_swarming"), ExtResource("a_siege"), ExtResource("a_ironclad")])
boss = ExtResource("boss")
fight_health_scale = 0.5
events = Array[ExtResource("s_event")]([ExtResource("ev_gravediggers_cart"), ExtResource("ev_wounded_knight"), ExtResource("ev_flooded_crypt"), ExtResource("ev_the_tinker"), ExtResource("ev_night_fog"), ExtResource("ev_drowned_reliquary"), ExtResource("ev_giants_rib"), ExtResource("ev_stonecutters_cache")])
shrines = Array[ExtResource("s_event")]([ExtResource("ev_shrine_blood"), ExtResource("ev_shrine_ash"), ExtResource("ev_shrine_coins"), ExtResource("ev_shrine_hollow_walls"), ExtResource("ev_shrine_whispers")])
