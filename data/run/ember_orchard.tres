[resource]
script = ExtResource("1_chapter")
id = &"ember_orchard"
display_name = "The Ember Orchard"
tier = 1
level_scene = ExtResource("2_level")
map_look = ExtResource("look_ember_orchard")
blurb = "A burned orchard of blackened trees and dry, yellow grass. Three roads wind through it."
mechanic_text = "Dry grass: patches catch fire from burning ground or burning enemies, and the fire hurts you as well as them."
difficulty_note = "easy, and fire is a weapon here: a Brazier lights the grass"
battles = Array[ExtResource("s_enc")]([ExtResource("b1"), ExtResource("b2"), ExtResource("b3"), ExtResource("b4"), ExtResource("b5"), ExtResource("b6")])
elites = Array[ExtResource("s_enc")]([ExtResource("e3"), ExtResource("e4"), ExtResource("e5"), ExtResource("e6")])
affixes = Array[ExtResource("s_affix")]([ExtResource("a_swift"), ExtResource("a_warded"), ExtResource("a_swarming"), ExtResource("a_siege"), ExtResource("a_ironclad")])
boss = ExtResource("boss")
fight_health_scale = 0.6
events = Array[ExtResource("s_event")]([ExtResource("ev_gravediggers_cart"), ExtResource("ev_wounded_knight"), ExtResource("ev_flooded_crypt"), ExtResource("ev_the_tinker"), ExtResource("ev_night_fog"), ExtResource("ev_drowned_reliquary"), ExtResource("ev_glowing_fruit"), ExtResource("ev_orchard_keeper")])
shrines = Array[ExtResource("s_event")]([ExtResource("ev_shrine_blood"), ExtResource("ev_shrine_ash"), ExtResource("ev_shrine_coins"), ExtResource("ev_shrine_hollow_walls"), ExtResource("ev_shrine_whispers")])
