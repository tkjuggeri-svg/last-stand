[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://resources/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://resources/event_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://resources/event_effect.gd" id="3_effect"]
[ext_resource type="Resource" path="res://data/events/fog_march.tres" id="r0"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("3_effect")
type = 10
affix = ExtResource("r0")
amount = 1

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_choice")
label = "March on"
outcome = "The next fight: enemies 15% faster, but they pay 50% more gold."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_1")])
result_text = "You march into the fog."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("3_effect")
type = 11
factor = 1.2

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("2_choice")
label = "Wait it out"
outcome = "Nothing here, but the roads were closed: the next merchant's prices +20%."
effects = Array[ExtResource("3_effect")]([SubResource("Resource_3")])
result_text = "The fog lifts by morning. Word is, prices went up."

[resource]
script = ExtResource("1_event")
id = &"night_fog"
title = "The Night Fog"
text = "A cold fog rolls over the fields. Shapes move in it."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_2"), SubResource("Resource_4")])
