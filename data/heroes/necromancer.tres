[resource]
script = ExtResource("1_data")
id = &"necromancer"
display_name = "The Necromancer"
description = "The gravecaller: a soul bolt; every kill it lands raises a skeleton (3 at a time) that fights for her.\nWeak against single big targets: bosses, and skeletons die fast."
max_health = 80
move_speed = 195.0
attack_damage = 6
attack_cooldown = 0.45
attack_duration = 0.12
knockback = 4.0
frames = ExtResource("2_frames")
raise_minion = ExtResource("4_skeleton")
raise_cap = 3
bolt_frames = ExtResource("3_bolt")
bolt_look = &"soul_bolt"
bolt_sound = &"hero_soul_bolt"
attack_kind = 1
bolt_range = 220.0
bolt_speed = 480.0
bolt_pierce = 0
mark_bonus = 0.0
mark_time = 3.0
exclusive_towers = Array[ExtResource("5_tower")]([ExtResource("6_pit"), ExtResource("7_siphon"), ExtResource("8_ossuary")])
exclusive_cards = Array[ExtResource("9_card")]([ExtResource("11_c1"), ExtResource("12_c2"), ExtResource("13_c3"), ExtResource("14_c4")])
exclusive_relics = Array[ExtResource("10_relic")]([ExtResource("15_rel"), ExtResource("16_crown")])
