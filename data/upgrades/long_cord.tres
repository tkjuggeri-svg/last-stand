[resource]
script = ExtResource("3_up")
id = &"long_cord"
display_name = "Long Cord"
description = "Trap Layers throw 25% further and 15% faster."
icon = ExtResource("1_icon")
category = 1
rarity = 1
stackable = false
modifiers = Array[ExtResource("2_mod")]([SubResource("Mod_0"), SubResource("Mod_1")])
tags = Array[StringName]([&"traps"])
