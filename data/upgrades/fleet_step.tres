[gd_resource type="Resource" script_class="UpgradeData" format=3]

[ext_resource type="Texture2D" path="res://assets/sprites/ui/upgrades/fleet_step.png" id="1_icon"]
[ext_resource type="Script" path="res://resources/stat_modifier.gd" id="2_mod"]
[ext_resource type="Script" path="res://resources/upgrade_data.gd" id="3_data"]

[sub_resource type="Resource" id="Resource_cooldown"]
script = ExtResource("2_mod")
stat = &"hero.dash_cooldown"
percent = -0.25

[resource]
script = ExtResource("3_data")
id = &"fleet_step"
display_name = "Fleet Step"
description = "Dash recharges 25% faster."
icon = ExtResource("1_icon")
modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_cooldown")])
