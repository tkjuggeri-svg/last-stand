character = &"orm"
text = "Ashen Keep, was it? My old forge is there. Is the anvil still cold?"
priority = 12
condition = SubResource("s35")

[sub_resource type="Resource" id="s37"]
script = ExtResource("3")
last_result = "won"

[sub_resource type="Resource" id="s38"]
